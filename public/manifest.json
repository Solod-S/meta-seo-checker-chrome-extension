{
  "manifest_version": 3,
  "name": "META SEO Checker",
  "short_name": "META SEO Checker",
  "version": "1.0.0",
  "description": "Inspect titles, meta tags, headings, images, links, Open Graph, Twitter Cards and structured data in one click.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "META SEO Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
